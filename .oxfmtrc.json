{
    "$schema": "./node_modules/oxfmt/configuration_schema.json",
    "printWidth": 100,
    "tabWidth": 4,
    "useTabs": false,
    "semi": true,
    "singleQuote": false,
    "trailingComma": "all",
    "sortImports": false,
    "sortPackageJson": false,
    "ignorePatterns": [
        "**/dist/**",
        "**/build/**",
        "**/coverage/**",
        "**/drizzle/**",
        "**/*.min.js"
    ]
}
